<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvOrderNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="订单号: ORD-000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"/>

            <TextView
                android:id="@+id/tvSmallCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="小仓提货号: 001"
                android:textColor="#2980B9"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#BDC3C7"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvTaskGoodsName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="大仓对应：阿莫西林胶囊 (A-001)"
            android:textColor="#7F8C8D"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/tvTaskLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📍 提货货架：A区-1排"
            android:textColor="#7F8C8D"
            android:textSize="14sp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="任务佣金: ¥12.50"
                android:textColor="#E67E22"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <Button
                android:id="@+id/btnClaim"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:backgroundTint="#27AE60"
                android:text="立即抢单"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:padding="0dp"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>