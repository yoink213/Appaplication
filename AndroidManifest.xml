<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.yourapp"> <!-- 1. 建议显式声明包名 -->

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 优化建议：如果应用主要在前台使用网络，建议添加以下权限以优化后台电量 -->
    <!-- <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" /> -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true" <!-- 2. 兼容旧版存储权限（如需） -->
    tools:targetApi="31"> <!-- 3. 声明工具API级别，避免编译警告 -->

    <!-- 主入口 Activity -->
    <activity
        android:name=".MainActivity"
        android:exported="true" <!-- 4. Android 12+ 必须显式声明 exported 属性 -->
    android:screenOrientation="portrait"> <!-- 5. 优化：锁定竖屏，防止数据因旋转重置（可选） -->
    <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
    </intent-filter>
</activity>

    <!-- 业务页面注册 -->
    <!-- 优化：默认情况下，没有 intent-filter 的 Activity exported 默认为 false，更安全 -->
<activity android:name=".LoginActivity" />
<activity android:name=".WarehouseActivity" />
<activity android:name=".TaskPoolActivity" />
<activity android:name=".AdminOrdersActivity" />
<activity android:name=".MyOrdersActivity" />
<activity android:name=".AdminAuditActivity" />
<activity android:name=".DashboardActivity" />
<activity android:name=".ReplenishActivity" />

    </application>
    </manifest>